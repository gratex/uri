{
    "name": "@gjax/uri",
    "version": "1.3.0",
    "description": "Convenient uri API",
    "main": "./src/index.js",
    "engines": {
        "node": ">=8.6.0"
    },
    "keywords": [
        "uri",
        "url",
        "query",
        "encode",
        "url builder",
        "es6 template"
    ],
    "dependencies": {
        "lodash.isequalwith": "^4.4.0",
        "qs": "^6.14.0"
    },
    "devDependencies": {
        "@stryker-mutator/core": "^9.3.0",
        "@stryker-mutator/jest-runner": "^9.3.0",
        "coveralls": "^3.1.0",
        "docdash": "^2.0.2",
        "dtsmake": "^0.0.6",
        "esformatter": "^0.11.3",
        "esformatter-eol-last": "^1.0.0",
        "esformatter-limit-linebreaks": "0.0.3",
        "eslint": "^9.39.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jsdoc": "^4.0.5",
        "pre-commit": "^1.2.2",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "coveralls": "cat ./coverage/lcov.info | node coveralls",
        "test": "jest",
        "test-coverage": "jest --coverage",
        "lint": "eslint ./src ./test",
        "lint-hook": "bash ./scripts/lint-hook.sh",
        "formatter-hook": "bash ./scripts/formatter-hook.sh",
        "gen-docs": "rm -rf doc/api | jsdoc -c jsdoc.conf.json",
        "check-typings": "tsc --project typings"
    },
    "pre-commit": [
        "lint-hook",
        "formatter-hook"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/gratex/uri"
    },
    "author": "",
    "license": "ISC",
    "typings": "./typings/index.d.ts",
    "jest": {
        "testEnvironment": "jsdom",
        "testEnvironmentOptions": {
            "url": "http://localhost/foo/"
        },
        "testMatch": [
            "**/test/*.test.js",
            "**/test/*.test2.js"
        ]
    }
}
